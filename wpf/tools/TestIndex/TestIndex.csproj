<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deterministic Reqnroll/SpecFlow step index for agents. Targets the installed .NET 10 SDK;
       change TargetFramework if a different SDK is installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>testindex</AssemblyName>
    <RootNamespace>TestIndex</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
