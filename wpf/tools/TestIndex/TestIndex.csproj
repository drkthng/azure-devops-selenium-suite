<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deterministic Reqnroll/SpecFlow step index for agents. If net8.0 is not installed,
       set TargetFramework to an installed SDK version (net6.0 or newer). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>testindex</AssemblyName>
    <RootNamespace>TestIndex</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
